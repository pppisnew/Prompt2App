# =================================================================
# Prompt2App · 环境变量样例（ADR-0010 配置统一化）
#
# 用法：
#   1. 复制本文件为 .env 放在项目根目录： cp .env.example .env
#   2. 填入真实值。.env 已加入 .gitignore，不会被提交。
#   3. spring-dotenv 会自动注入 .env 到 Spring Environment，application.yml 中的
#      ${VAR:default} 占位符将优先读取此处的值。
#   4. 优先级（高 → 低）：
#      JVM -D > CLI -- > OS env > .env (本文件) > application-{profile}.yml > application.yml
#
# 命名约定：
#   - 大写下划线
#   - 业务前缀：PROMPT2APP_*（路径、工具配额）
#   - 基础设施：DB_* / REDIS_* / SERVER_*
#   - 第三方：LLM_* / COS_* / DASHSCOPE_* / PEXELS_*
# =================================================================

# -------- 环境标识 --------
# 取值：local | dev | test | prod
SPRING_PROFILES_ACTIVE=local

# -------- 应用 / 服务器 --------
APP_NAME=Prompt2App-backend
SERVER_PORT=8123
SERVER_CONTEXT_PATH=/api
# 单位：秒；2592000 = 30 天
SERVER_COOKIE_MAX_AGE=2592000
SESSION_TIMEOUT=2592000

# -------- MySQL --------
# createDatabaseIfNotExist=true 让首启动自动建库（不会建表，表仍由 sql/create_table.sql 跑）
DB_URL=jdbc:mysql://localhost:3306/prompt2app?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4
DB_USERNAME=root
DB_PASSWORD=

# -------- Redis --------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
# 缓存过期（秒）
REDIS_TTL=3600

# -------- Spring Session / Cache 命名空间（防跨项目 Redis 污染，事故复盘 2026-06-19） --------
SPRING_SESSION_REDIS_NAMESPACE=prompt2app:session
SPRING_CACHE_REDIS_KEY_PREFIX=prompt2app:cache:

# -------- LLM · 主对话模型 --------
LLM_CHAT_BASE_URL=https://api.deepseek.com
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_CHAT_MAX_TOKENS=8192
LLM_CHAT_LOG_REQUESTS=true
LLM_CHAT_LOG_RESPONSES=true
LLM_CHAT_MAX_RETRIES=3

# -------- LLM · 流式对话 --------
LLM_STREAM_BASE_URL=https://api.deepseek.com
LLM_STREAM_API_KEY=
LLM_STREAM_MODEL=deepseek-chat
LLM_STREAM_MAX_TOKENS=8192
LLM_STREAM_LOG_REQUESTS=true
LLM_STREAM_LOG_RESPONSES=true

# -------- LLM · 推理模型（复杂任务） --------
LLM_REASONING_BASE_URL=https://api.deepseek.com
LLM_REASONING_API_KEY=
LLM_REASONING_MODEL=deepseek-reasoner
LLM_REASONING_MAX_TOKENS=32768
LLM_REASONING_TEMPERATURE=0.1
LLM_REASONING_LOG_REQUESTS=true
LLM_REASONING_LOG_RESPONSES=true

# -------- LLM · 智能路由模型（轻量分类，ADR-0003） --------
LLM_ROUTING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_ROUTING_API_KEY=
LLM_ROUTING_MODEL=qwen-turbo
LLM_ROUTING_MAX_TOKENS=100
LLM_ROUTING_LOG_REQUESTS=true
LLM_ROUTING_LOG_RESPONSES=true

# -------- 腾讯云 COS（对象存储） --------
COS_HOST=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=

# -------- Pexels（图片搜索） --------
PEXELS_API_KEY=

# -------- 阿里云 DashScope（图像生成） --------
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash

# -------- 业务部署路径（ADR-0010） --------
# 与原 AppConstant 对齐；留空时回落到 ${user.dir}/tmp/...
PROMPT2APP_CODE_OUTPUT_DIR=
PROMPT2APP_CODE_DEPLOY_DIR=
PROMPT2APP_SCREENSHOTS_DIR=
# 部署 host：用于拼接静态资源访问 URL
PROMPT2APP_CODE_DEPLOY_HOST=http://localhost
# 旧 key 兼容（AppServiceImpl 之前直接读 ${code.deploy-host}）
CODE_DEPLOY_HOST=http://localhost

# -------- AI 工具调用配额（ADR-0008） --------
PROMPT2APP_TOOL_MAX_PER_SESSION=50
PROMPT2APP_TOOL_MAX_PER_FILE=10

# -------- Knife4j / Actuator 开关 --------
KNIFE4J_ENABLE=true
MANAGEMENT_ENDPOINTS=health,info,prometheus
MANAGEMENT_HEALTH_DETAILS=always
